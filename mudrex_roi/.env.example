# ============================================================================
# Mudrex signal trader — copy to .env and fill in LOCALLY. Never commit .env.
# Real environment variables override values in .env.
# ============================================================================

# ---- Mode ------------------------------------------------------------------
# PAPER = fully simulated (default). REAL = live Mudrex futures trading.
TRADING_MODE=PAPER
# Kill switch: false = no new trades are opened (monitoring of open positions continues).
TRADING_ENABLED=true
# REAL additionally requires ENABLE_REAL_TRADING=true AND the exact acknowledgement below.
ENABLE_REAL_TRADING=false
LIVE_TRADING_ACKNOWLEDGEMENT=

# ---- Mudrex ----------------------------------------------------------------
# Mudrex creates an "API Key" AND a "Secret Key" when you generate a key.
#   - Put the "Secret Key" here. It is sent as the X-Authentication header.
#   - The "API Key" (the shorter ID) is NOT used by this bot; do not put it here.
# The Secret Key is shown only once. If you lose it, revoke the key and generate a new one.
# PAPER mode needs only a READ-ONLY key (metadata + prices).
# REAL mode needs trading scope. Never enable withdrawal or transfer scopes.
# Paste the value locally into .env. Never share it in chat, screenshots, or commits.
MUDREX_API_SECRET=
MUDREX_BASE_URL=https://trade.mudrex.com

# ---- Sizing & risk ---------------------------------------------------------
TRADE_CURRENCY=USDT
MAX_MARGIN_USDT_PER_TRADE=50
# Retained inside the per-trade margin budget and required as free balance on top of margin.
MARGIN_RESERVE_USDT=2
MAX_CONCURRENT_POSITIONS=50
MAX_ENTRY_DEVIATION_PCT=3
MAX_SIGNAL_AGE_MINUTES=5
LIMIT_ORDER_TTL_MINUTES=120
TARGET_ORDER_TYPE=LIMIT
TARGET_ROI_PCT=8.0

# ---- PAPER simulation ------------------------------------------------------
PAPER_INITIAL_BALANCE_USDT=1000
PAPER_FEE_RATE=0.0002
PAPER_MAINTENANCE_MARGIN_RATE=0.005

# ---- Telegram (MTProto) ----------------------------------------------------
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# International format, e.g. +919876543210 (used only for first-time login)
TELEGRAM_PHONE=
# Session file base path (Telethon adds .session). Stored under ./data — never commit it.
TELEGRAM_SESSION_NAME=./data/telegram_session
TELEGRAM_CHANNEL_INVITE_URL=https://t.me/+Xh7OTE_G_jcxMDE0

# ---- Storage & runtime -----------------------------------------------------
DATABASE_PATH=./data/trading.db
MONITOR_POLL_SECONDS=10
ASSET_CACHE_TTL_SECONDS=600
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=10
LOG_LEVEL=INFO

# ---- Optional notification bot (never required for trading) ---------------
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
