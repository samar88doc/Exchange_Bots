# ============================================================================
# Pi42 signal trader — copy to .env and fill in LOCALLY. Never commit .env.
# Real environment variables override values in .env.
# ============================================================================

# ---- Mode ------------------------------------------------------------------
# PAPER = fully simulated against live prices (default). REAL = live Pi42 futures.
TRADING_MODE=PAPER
# Kill switch: false = no new trades are opened (open positions are still monitored).
TRADING_ENABLED=true
# REAL additionally requires ENABLE_REAL_TRADING=true AND the exact acknowledgement below.
ENABLE_REAL_TRADING=false
LIVE_TRADING_ACKNOWLEDGEMENT=

# ---- Pi42 ------------------------------------------------------------------
# Create an API key in Pi42 (API management) and WHITELIST YOUR SERVER IP —
# Pi42 rejects requests from other addresses. The key pair is:
#   PI42_API_KEY    = the public key id (sent in the `api-key` header)
#   PI42_API_SECRET = the secret used to sign requests (HMAC-SHA256)
# PAPER needs only a READ-ONLY key (contract metadata + futures wallet read).
# REAL needs trading permission. Never grant withdrawal/transfer permissions:
# this bot contains no transfer or withdrawal code at all.
PI42_API_KEY=
PI42_API_SECRET=
PI42_BASE_URL=https://fapi.pi42.com
PI42_PUBLIC_BASE_URL=https://api.pi42.com
# PI42_MARKET is the quote currency of the contracts traded. Signals quoted in
# the other currency are REJECTED, never converted: #CRV/USDT needs USDT here.
PI42_MARKET=USDT
# Margin currency. Defaults to PI42_MARKET. BTCINR can also be margined in USDT.
PI42_MARGIN_ASSET=USDT
# ISOLATED is strongly recommended; CROSS puts the whole wallet behind one trade.
PI42_MARGIN_MODE=ISOLATED
# Send our deterministic refId with each order. It makes a lost response
# recoverable (Pi42 answers "ref id already exists", which we adopt, never resubmit).
PI42_SEND_REF_ID=true
# Optional Pi42 tracking fields. Leave empty unless Pi42 support asks for them.
PI42_DEVICE_TYPE=
PI42_USER_CATEGORY=

# ---- Sizing & risk ---------------------------------------------------------
# Margin (in PI42_MARGIN_ASSET) allocated per trade: max_margin - reserve.
MAX_MARGIN_PER_TRADE=50
MARGIN_RESERVE=2
MAX_CONCURRENT_POSITIONS=50
# Skip a signal whose entry is further than this from the live price (limit is never moved).
MAX_ENTRY_DEVIATION_PCT=3
MAX_SIGNAL_AGE_MINUTES=5
# Unfilled LIMIT entries are cancelled after this many minutes (0 disables).
LIMIT_ORDER_TTL_MINUTES=120
# ROI take-profit attached to the entry order: entry +/- TARGET_ROI_PCT percent.
TARGET_ROI_PCT=8.0
# Label only; the exit is a Pi42 take-profit on the entry order.
TARGET_ORDER_TYPE=LIMIT

# ---- PAPER simulation ------------------------------------------------------
PAPER_INITIAL_BALANCE=1000
# Pi42 taker fee is ~0.05% (0.0005); maker is lower.
PAPER_FEE_RATE=0.0005
# Maintenance margin fraction used by the approximate liquidation model.
PAPER_MAINTENANCE_MARGIN_RATE=0.005

# ---- Telegram (MTProto) ----------------------------------------------------
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# International format, e.g. +919876543210 (used only for first-time login)
TELEGRAM_PHONE=
# Session file base path (Telethon adds .session). Stored under ./data — never commit it.
TELEGRAM_SESSION_NAME=./data/telegram_session
TELEGRAM_CHANNEL_INVITE_URL=https://t.me/+Xh7OTE_G_jcxMDE0

# ---- Storage & runtime -----------------------------------------------------
DATABASE_PATH=./data/trading.db
MONITOR_POLL_SECONDS=15
CONTRACT_CACHE_TTL_SECONDS=600
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=10
# Pi42 rate limits: 20 place-order/s, 30 delete/min, 60/min for everything else.
PI42_REQUESTS_PER_MINUTE=50
PI42_DELETE_REQUESTS_PER_MINUTE=25
DASHBOARD_PORT=8500
LOG_LEVEL=INFO

# ---- Optional notification bot (never required for trading) ---------------
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
