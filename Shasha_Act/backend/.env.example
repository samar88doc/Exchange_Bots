# Copy to backend/.env for local configuration. Never commit the copied .env file.
APP_NAME=Shasha_Act
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://shasha_act:change-me@localhost:5432/shasha_act
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:8000

# Safe defaults: keep PAPER mode and every LIVE gate closed during setup.
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
SHARK_CONTRACT_RULES_VERIFIED=false
SHARK_SPLIT_PROTECTION_VERIFIED=false
EMERGENCY_TRADING_DISABLED=false

# Generate unique long random values locally; these placeholders are not usable credentials.
DASHBOARD_API_TOKEN=replace-with-a-random-dashboard-token
TRADINGVIEW_WEBHOOK_TOKEN=replace-with-a-different-random-webhook-token

# Server-side risk defaults. Dashboard edits persist in PostgreSQL.
MARGIN_PER_TRADE=100
LEVERAGE=10
MAX_OPEN_POSITIONS=3
TARGET1_PERCENT=1
TARGET2_PERCENT=2
TARGET3_PERCENT=3
STOP_LOSS_PERCENT=2
MAX_NOTIONAL_PER_TRADE=1000
MAX_DAILY_LOSS=200
LIMIT_ENTRY_EXPIRY_SECONDS=900
CANCEL_STALE_ENTRY_ORDERS=true
ALLOW_SYMBOLS=
DENY_SYMBOLS=

# Paper simulation. Fees are estimates, not a statement about live charges.
PAPER_INITIAL_BALANCE=10000
PAPER_MAKER_FEE_BPS=2
PAPER_TAKER_FEE_BPS=5

# Shark public API and public Socket.IO feed. Private credentials are not required for PAPER.
SHARK_BASE_URL=https://api.sharkexchange.in
SHARK_PUBLIC_WS_URL=https://fawss.sharkexchange.in
SHARK_API_KEY=
SHARK_API_SECRET=
SHARK_MARGIN_ASSET=USDT
SHARK_DEVICE_TYPE=WEB
SHARK_USER_CATEGORY=EXTERNAL
SHARK_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_SUBSCRIPTIONS=20
MARKET_DATA_STALE_SECONDS=30
MARKET_DATA_POLL_SECONDS=60

# Optional Telegram delivery. If unset, notifications remain durable and retry visibly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=8

WEBHOOK_MAX_BODY_BYTES=16384
WEBHOOK_RATE_LIMIT_PER_MINUTE=30
WORKER_POLL_SECONDS=0.5
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=12
RECONCILIATION_INTERVAL_SECONDS=20
RUN_WORKERS=true
RUN_MARKET_STREAM=true
RUN_MARKET_POLL=true
