# Copy to backend/.env for local configuration. Never commit the copied .env file.
APP_NAME=Shasha_Act
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://shasha_act:change-me@localhost:5432/shasha_act
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:8000

# Safe defaults: keep PAPER mode and every LIVE gate closed during setup.
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
SHARK_CONTRACT_RULES_VERIFIED=false
SHARK_SPLIT_PROTECTION_VERIFIED=false
EMERGENCY_TRADING_DISABLED=false

# ---------------------------------------------------------------- dashboard access --
# Dashboard authentication is always enabled. Operators sign in with username/password;
# they are never asked to paste an automation token into the browser.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password
DASHBOARD_SESSION_HOURS=12
DASHBOARD_REMEMBER_SESSION_DAYS=30
# Optional: server-to-server automation only. Leave empty if unused.
DASHBOARD_API_TOKEN=
# For a first deployment without DASHBOARD_PASSWORD only, set this true temporarily, create
# the first OWNER through the sign-up screen, then set it false and restart.
INITIAL_OWNER_SIGNUP_ENABLED=false
PASSWORD_HASH_ITERATIONS=240000
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
# Production defaults to no framing. Set explicit trusted origins only when embedding is required.
DASHBOARD_ALLOW_FRAMING=false
DASHBOARD_FRAME_ANCESTORS=

TRADINGVIEW_WEBHOOK_TOKEN=replace-with-a-different-random-webhook-token

# ------------------------------------------------------ service subscription + terms --
SUBSCRIPTION_PLAN_NAME=SHASHA ACT PRO
SUBSCRIPTION_FEE=999
SUBSCRIPTION_CURRENCY=INR
SUBSCRIPTION_BILLING_CYCLE=MONTHLY
SUBSCRIPTION_STARTED_AT=
SUBSCRIPTION_EXPIRES_AT=
# When true, new signals are refused while the plan is expired, suspended or cancelled.
ENFORCE_SUBSCRIPTION=false
# When true, order-changing dashboard calls need an acknowledged risk disclaimer.
REQUIRE_DISCLAIMER_ACK=true

# ------------------------------------------------------- risk + SHASHA entry/exit rules --
# Server-side risk defaults. Dashboard edits persist in PostgreSQL.
MARGIN_PER_TRADE=100
LEVERAGE=10
MAX_OPEN_POSITIONS=3
MAX_NOTIONAL_PER_TRADE=1000
MAX_DAILY_LOSS=200

# Entry price: the close of the last *completed* Shark candle for the symbol. TradingView
# (Binance) only triggers the signal; its price is never used as the entry.
ENTRY_PRICE_SOURCE=SHARK_CLOSED_CANDLE
ENTRY_CANDLE_INTERVAL=5m
ENTRY_CANDLE_MAX_AGE_SECONDS=1800
# false = strict: an unavailable/stale Shark candle rejects the signal instead of entering
# at a live tick that may differ from the candle close.
ENTRY_ALLOW_LIVE_TICKER_FALLBACK=false

# Stop loss 2% from entry, Target 1 2% from entry closing 50% of the position, then the stop
# moves to the entry price (break-even) and trails 1% behind every new 1% high.
STOP_LOSS_PERCENT=2
TARGET1_PERCENT=2
TARGET1_CLOSE_PERCENT=50
TRAILING_STOP_PERCENT=1
TRAILING_ENABLED=true
# Optional fixed Target 2 / Target 3 ladder. Off by default so the runner trails instead.
ENABLE_SECONDARY_TARGETS=false
TARGET2_PERCENT=3
TARGET3_PERCENT=4

LIMIT_ENTRY_EXPIRY_SECONDS=900
CANCEL_STALE_ENTRY_ORDERS=true
ALLOW_SYMBOLS=
DENY_SYMBOLS=

# Paper simulation. Fees are estimates, not a statement about live charges.
PAPER_INITIAL_BALANCE=10000
PAPER_MAKER_FEE_BPS=2
PAPER_TAKER_FEE_BPS=5

# Shark public API and public Socket.IO feed. Private credentials are not required for PAPER.
SHARK_BASE_URL=https://api.sharkexchange.in
SHARK_PUBLIC_WS_URL=https://fawss.sharkexchange.in
SHARK_API_KEY=
SHARK_API_SECRET=
SHARK_MARGIN_ASSET=USDT
SHARK_DEVICE_TYPE=WEB
SHARK_USER_CATEGORY=EXTERNAL
SHARK_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_SUBSCRIPTIONS=350
MARKET_DATA_STALE_SECONDS=30
MARKET_DATA_POLL_SECONDS=60

# Optional Telegram delivery. If unset, notifications remain durable and retry visibly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=8

WEBHOOK_MAX_BODY_BYTES=16384
WEBHOOK_RATE_LIMIT_PER_MINUTE=30
WORKER_POLL_SECONDS=0.5
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=12
RECONCILIATION_INTERVAL_SECONDS=20
RUN_WORKERS=true
RUN_MARKET_STREAM=true
RUN_MARKET_POLL=true
