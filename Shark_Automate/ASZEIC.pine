plot(kernelSignal     ? 1 : 0, title="KERNEL Signal",      display=display.data_window)
plot(ema200Signal     ? 1 : 0, title="EMA200 Signal",      display=display.data_window)
plot(emaMakerSignal   ? 1 : 0, title="EMAKER Signal",      display=display.data_window)
plot(kmakerSignal     ? 1 : 0, title="KMAKER Signal",      display=display.data_window)
plot(kmakerOnlySignal ? 1 : 0, title="KMAKER Only Signal", display=display.data_window)
plot(intMakerSignal   ? 1 : 0, title="INTMAKER Signal",    display=display.data_window)
plot(intMakerTrigger  ? 1 : 0, title="INTMAKER Trigger",   display=display.data_window)
plot(ktoucherSignal   ? 1 : 0, title="KTOUCHER Signal",    display=display.data_window)

