plot(scoreEmaker,     title="EMAKER Score",         display=display.data_window)
plot(scoreKmaker,     title="KMAKER Score",         display=display.data_window)
plot(scoreIntmaker,   title="INTMAKER Score",       display=display.data_window)
plot(scoreKtoucher,   title="KTOUCHER Score",       display=display.data_window)
