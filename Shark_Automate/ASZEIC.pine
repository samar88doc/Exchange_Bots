// KMAKER / INTMAKER LABELS
// ═══════════════════════════════════════════════════════════════════════════
if kmakerOnlySignal
    label.new(x=bar_index, y=na, text="KMAKR", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.small)

if intMakerTrigger
    label.new(x=bar_index, y=na, text="INT " + str.tostring(intMakerDayCount), yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.maroon, 0), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// KTOUCHER LABEL  (1 point)
// ═══════════════════════════════════════════════════════════════════════════
if ktoucherSignal
    label.new(x=bar_index, y=na, text="KTOUCH", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.fuchsia, 0), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════
bool combined = kernelSignal or ema200Signal or emaMakerSignal or kmakerSignal or intMakerSignal or ktoucherSignal


bool threshold_idea = totalScore >= scoreAlertThreshold


bool masterAnySignal = aAny or (kernelSignal or ema200Signal or emaMakerSignal or kmakerSignal or intMakerSignal or ktoucherSignal)



// ── V4 user inputs ─────────────────────────────────────────────────────────
groupCustom = "🔔 V4 · Midpoint Touch Alert"
midAlertMinClass = input.string("STRONG+", "Midpoint-touch alert · minimum zone class", options = ["NORMAL+", "STRONG+", "MAJOR only"], group = groupCustom, tooltip = "Alert fires only when the STRONGEST active zone (the one in the top-right panel) is at least this class. NORMAL+ = 2+, STRONG+ = 3+ (STRONG or MAJOR), MAJOR only = 4 (MAJOR only).")
midAlertNeedHTF  = input.bool(false, "Midpoint-touch alert · require HTF confluence (YES)", group = groupCustom, tooltip = "ON = alert only when the strongest zone also has HTF confluence (YES in panel).")

groupSniper = "🎯 V4 · A+ Sniper Alert"
sniperMinScore     = input.float(5.0,  "A+ minimum Total Score (0-12)", minval=0, maxval=12, step=0.5, group=groupSniper, tooltip="Total Score (the panel SCORE x/12) must be at least this value on the alert bar.")
sniperMinZoneScr   = input.float(80.0, "A+ minimum Zone Score (80 = MAJOR)", minval=0, maxval=100, step=5, group=groupSniper, tooltip="The strongest active zone's 0-100 score must be at least this. 80 = MAJOR class.")
sniperSpringWindow = input.int(0,      "Spring fired within N bars (0 = same bar only)", minval=0, maxval=10, group=groupSniper, tooltip="0 = pure sniper: spring and ALL other conditions must be on the SAME candle. 1-2 = the spring may have fired 1-2 bars ago; alert still fires while other conditions line up (useful for retest entries).")
sniperBgHighlight  = input.bool(true,  "Highlight A+ bars (aqua background)", group=groupSniper, tooltip="Paints an aqua background on every bar where the A+ condition is true — easy to verify in Bar Replay / history.")

float midMinCls    = midAlertMinClass == "NORMAL+" ? 2.0 : midAlertMinClass == "STRONG+" ? 3.0 : 4.0
bool  midTouchRaw  = sActive > 0 and not na(sMid) and low <= sMid and low[1] > sMid and low >= sLow
bool  midTouchAlert = midTouchRaw and sStrength >= midMinCls and (not midAlertNeedHTF or sHtfCon)

// ═══════════════════════════════════════════════════════════════════════════
// ALERT 2 · SPRING QUALITY (existing false-break/spring + RSI momentum gate)
// ═══════════════════════════════════════════════════════════════════════════
bool springQuality = aSpring and rsi14 > 50

// ═══════════════════════════════════════════════════════════════════════════
// ALERT 3 · A+ SNIPER = SPRING + MAJOR(80+) zone + HTF YES + Total Score ≥ N
// ═══════════════════════════════════════════════════════════════════════════
int  springSince  = ta.barssince(evSpring)
bool springReady  = sniperSpringWindow <= 0 ? evSpring : (evSpring or (not na(springSince) and springSince <= sniperSpringWindow))
bool aPlusSetup   = springReady and sActive > 0 and not na(sScore) and sScore >= sniperMinZoneScr and sHtfCon and totalScore >= sniperMinScore

// ── V4 alertcondition entries (appear in the alert dropdown) ──────────────

// ── V4 dynamic alert() with full price details ─────────────────────────────
// (to receive these, create the alert with condition = "Any alert() function call")
if in_alerts and midTouchAlert
    alert("MID-TOUCH " + syminfo.ticker + ": zone " + str.tostring(sLow, format.mintick) + " – " + str.tostring(sHigh, format.mintick) + " | MID " + str.tostring(sMid, format.mintick) + " tested @ " + str.tostring(low, format.mintick) + ". Watch for bounce/spring confirm.", alert.freq_once_per_bar_close)

if in_alerts and aPlusSetup
    alert("🎯 A+ " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | Zone " + str.tostring(sLow, format.mintick) + "-" + str.tostring(sHigh, format.mintick) + " (zone score " + str.tostring(sScore, "#") + ") | TotalScore " + str.tostring(totalScore, "#") + "/12 | SPRING+MAJOR+HTF ✔", alert.freq_once_per_bar_close)

// ── V4 visual proof + data-window exports (for Bar Replay verification) ───
bgcolor(sniperBgHighlight and aPlusSetup ? color.new(color.aqua, 65) : na, title = "V4 · A+ Setup bar")
//plot(midTouchAlert ? 1.0 : 0.0, title = "V4 Midpoint Touch",  display = display.data_window)
//plot(springQuality ? 1.0 : 0.0, title = "V4 SPRING Quality",  display = display.data_window)
//plot(aPlusSetup ? 1.0 : 0.0,    title = "V4 A+ Setup Signal", display = display.data_window)

float htfBoxTop    = not na(htfBox) ? box.get_top(htfBox)    : na
float htfBoxBot    = not na(htfBox) ? box.get_bottom(htfBox) : na
bool  htfZoneActive = htfOn and not htfStopped and not na(htfBoxTop) and not na(htfBoxBot)

// ═══════════════════════════════════════════════════════════════════════════
// ALERT 4 · Any candle whose range overlaps the HTF zone box
// ═══════════════════════════════════════════════════════════════════════════
bool htfCandleInside = htfZoneActive and low <= htfBoxTop and high >= htfBoxBot

// ═══════════════════════════════════════════════════════════════════════════
// ALERT 5 · Candle inside the HTF zone box AND any combined Intmaker signal
//   fires on the same bar (reuses the existing `intmakerAnySignal` flag —
//   the same one already used for the Confluence Bonus score component).
// ═══════════════════════════════════════════════════════════════════════════
bool htfInsideAndCombined = htfCandleInside and intmakerAnySignal

// ═══════════════════════════════════════════════════════════════════════════
// ALERT 6 · Candle overlaps the HTF zone box AND closes ABOVE the zone top
//   (a bullish reaction/breakout signature from inside the HTF zone).
// ═══════════════════════════════════════════════════════════════════════════
bool htfInsideCloseAbove = htfCandleInside and close > htfBoxTop

// ── V6 alertcondition entries (appear in the alert dropdown) ──────────────
// FIXED BUG: Was (htfInsideCloseAbove or htfInsideAndCombined or htfInsideCloseAbove) - duplicate htfInsideCloseAbove, missing htfCandleInside
// ── V6 dynamic alert() with full price details ─────────────────────────────
// (to receive these, create the alert with condition = "Any alert() function call")
if in_alerts and htfCandleInside
    alert("HTF ZONE TOUCH " + syminfo.ticker + ": candle inside HTF zone " + str.tostring(htfBoxBot, format.mintick) + " – " + str.tostring(htfBoxTop, format.mintick) + " @ " + str.tostring(close, format.mintick) + ".", alert.freq_once_per_bar_close)

if in_alerts and htfInsideAndCombined
    alert("HTF ZONE + SIGNAL " + syminfo.ticker + ": candle inside HTF zone @ " + str.tostring(close, format.mintick) + " with a combined Intmaker signal (KERNEL/EMA200/EMAKER/KMAKER/INTMAKER/KTOUCHER) on the same bar.", alert.freq_once_per_bar_close)

if in_alerts and htfInsideCloseAbove
    alert("HTF ZONE BREAKOUT " + syminfo.ticker + ": candle inside HTF zone closed ABOVE zone top (" + str.tostring(htfBoxTop, format.mintick) + ") @ " + str.tostring(close, format.mintick) + ".", alert.freq_once_per_bar_close)

// ── V6 data-window exports (for Bar Replay / screener verification) ───────
plot(htfCandleInside      ? 1.0 : 0.0, title = "V6 HTF Zone Candle Inside",     display = display.data_window)
plot(htfInsideAndCombined ? 1.0 : 0.0, title = "V6 HTF Zone + Combined Signal", display = display.data_window)
plot(htfInsideCloseAbove  ? 1.0 : 0.0, title = "V6 HTF Zone Close Above Top",   display = display.data_window)



groupZoneInside = "🔔 V7 · Strong/Major Zone Inside Alert"
zoneInsideMinClass = input.string("STRONG+", "Zone-inside alert · minimum zone class", options = ["STRONG+", "MAJOR only"], group = groupZoneInside, tooltip = "Fires when the CURRENT CANDLE'S RANGE overlaps the STRONGEST ACTIVE zone (same zone shown in the top-right panel), and that zone is at least this class. STRONG+ = STRONG or MAJOR (score >= 60). MAJOR only = score >= 80.")
zoneInsideBgHighlight = input.bool(false, "Highlight bars where candle is inside STRONG/MAJOR zone (orange background)", group = groupZoneInside)

// ── V7 helper: minimum class threshold + full candle-range overlap test ────
float zoneInsideMinCls      = zoneInsideMinClass == "MAJOR only" ? 4.0 : 3.0
bool  zoneCandleOverlap     = sActive > 0 and not na(sLow) and not na(sHigh) and low <= sHigh and high >= sLow
bool  zoneStrongMajorInside = zoneCandleOverlap and sStrength >= zoneInsideMinCls

// ── V7 alertcondition entry (appears in the alert dropdown) ───────────────
bool zoneStrongMajorhtfInsideCombined = (zoneStrongMajorInside or htfCandleInside) and intmakerAnySignal
bool zoneStrongMajorhtfInsideCombinedprev = ((zoneStrongMajorInside[1] or htfCandleInside[1]) and intmakerAnySignal[1]) or  ((zoneStrongMajorInside[2] or htfCandleInside[2]) and intmakerAnySignal[2])

// ── V7 dynamic alert() with full price/class detail ────────────────────────
// (to receive this, create the alert with condition = "Any alert() function call")
if in_alerts and zoneStrongMajorInside
    alert("ZONE INSIDE " + syminfo.ticker + ": candle inside " + (sStrength >= 4.0 ? "MAJOR" : "STRONG") + " support zone " + str.tostring(sLow, format.mintick) + " – " + str.tostring(sHigh, format.mintick) + " (zone score " + str.tostring(sScore, "#") + ") @ " + str.tostring(close, format.mintick) + ".", alert.freq_once_per_bar_close)

// ── V7 visual proof + data-window export (for Bar Replay verification) ────
bgcolor(zoneInsideBgHighlight and zoneStrongMajorInside ? color.new(color.orange, 70) : na, title = "V7 · Strong/Major Zone Inside bar")
//plot(zoneStrongMajorhtfInsideCombined ? 1.0 : 0.0, title = "V7 Zone Inside STRONG/MAJOR/HTF_COMBINED", display = display.data_window)
//plot(htfInsideAndCombined ? 1.0 : 0.0, title = "V6 HTF Zone + Combined Signal", display = display.data_window)

groupSlope = "🔔 V8 · Slope Alignment Alert"
slopeMaxStreakBars = input.int(3, "Fire only on 1st…Nth consecutive bar of setup", minval = 1, maxval = 10, group = groupSlope, tooltip = "Once the raw SLOPE condition has been true for MORE than this many consecutive bars, the alert stops firing — prevents repeated alerts on a long-running trend. Resets the moment the condition goes false again.")
slopeBgHighlight = input.bool(false, "Highlight bars where SLOPE alignment is true (lime background)", group = groupSlope)

// ── V8 helper conditions (raw, unfiltered) ─────────────────────────────────
bool slopeKernelGreen   = krPlotColor == krBullColor                                   // Kernel line currently plotted bullish (green)
bool slopeStackAligned  = yhat1 > ema20 and ema20 > ema50 and ema50 > ema200            // stacked bullish order (same math as kernelEmaStructure)
bool slopeKernelRising  = yhat1  > yhat1[1]
bool slopeEma20Rising   = ema20  > ema20[1]
bool slopeEma50Rising   = ema50  > ema50[1]
bool slopeEma200Rising  = ema200 > ema200[1]
bool slopeAllRising     = slopeKernelRising and slopeEma20Rising and slopeEma50Rising and slopeEma200Rising

bool slopeSignalRaw = slopeKernelGreen and slopeStackAligned and slopeAllRising

// ── V8 streak counter: track consecutive TRUE bars, reset on any FALSE bar ─
var int slopeStreakCount = 0
if slopeSignalRaw
    slopeStreakCount := nz(slopeStreakCount[1]) + 1
else
    slopeStreakCount := 0

// ── V8 final gated signal: only bars 1..N of a fresh streak ───────────────
bool slopeSignal = slopeSignalRaw and slopeStreakCount <= slopeMaxStreakBars

// ── V8 alertcondition entry (appears in the alert dropdown) ───────────────

// ── V8 dynamic alert() with full line-value + streak detail ────────────────
// (to receive this, create the alert with condition = "Any alert() function call")
//if in_alerts and slopeSignal
//    alert("SLOPE " + syminfo.ticker + " [bar " + str.tostring(slopeStreakCount) + " of setup]: Kernel " + str.tostring(yhat1, format.mintick) + " > EMA20 " + str.tostring(ema20, format.mintick) + " > EMA50 " + str.tostring(ema50, format.mintick) + " > EMA200 " + str.tostring(ema200, format.mintick) + " — all rising @ " + str.tostring(close, format.mintick) + ".", alert.freq_once_per_bar_close)

// ── V8 visual proof + data-window exports (for Bar Replay verification) ───
bgcolor(slopeBgHighlight and slopeSignal ? color.new(color.lime, 70) : na, title = "V8 · Slope Alignment bar")
plot(slopeSignal ? 1.0 : 0.0,     title = "V8 Slope Alignment Signal (limited)", display = display.data_window)
//plot(slopeSignalRaw ? 1.0 : 0.0,  title = "V8 Slope Alignment Signal (raw)",     display = display.data_window)
//plot(slopeStreakCount,            title = "V8 Slope Streak Count",               display = display.data_window)

bool zoneStrongMajorhtfInsideCombinedSlope = zoneStrongMajorhtfInsideCombined and slopeSignal
if slopeSignal
    label.new(bar_index, low,"SLOPE", style = label.style_label_up, color = color.lime, textcolor = color.black, size = size.small)


bool slopeSignalMajorZoneWickOpen = slopeSignal and zoneStrongMajorInside and ((low >= sLow and low <= sHigh) or (open >= sLow and open <= sHigh))


// ============================================================================
// NEW · 3RD CONSECUTIVE SLOPE CANDLE
// Fires ONLY on the 3rd consecutive raw SLOPE candle
// ============================================================================

bool slopeThirdCandle = slopeSignalRaw and slopeStreakCount == 3

if slopeThirdCandle
    label.new(bar_index, low, "SLP3", style = label.style_label_up, color = color.lime, textcolor = color.black, size = size.small)
    // TradingView alert condition — ONLY the 3rd consecutive slope candle

bool slope_idea = slopeSignalMajorZoneWickOpen or slopeThirdCandle

bool overall = threshold_idea and (slope_idea or combined or zoneStrongMajorInside)


// ============================================================================
// ================== ALL ALERT CONDITIONS - CONSOLIDATED AT END ==============
// Each alert has 1-line explanation directly above it
// FIXED: Live/Prev HTF Zone bug corrected
// ============================================================================

// --- ASZE CORE (10) ---
// 1. New support zone born: 3+ pivots clustered, score>=50, new box drawn
//alertcondition(aNew, "New support zone detected", "ASZE: a new support zone was confirmed on {{ticker}} at {{close}} — a repeated-rejection support area has formed.")
// 2. Zone upgraded to STRONG: internal score >=60 (touches, rejections, holds, bounces, volume, age)
//alertcondition(aStrong, "Strong support detected", "ASZE: STRONG support confirmed on {{ticker}} at {{close}} (score >= 60).")
// 3. Zone upgraded to MAJOR: score >=80 - strongest zone on chart, many validations
//alertcondition(aMajor, "Major support detected", "ASZE: MAJOR support confirmed on {{ticker}} at {{close}} (score >= 80).")
// 4. Valid touch counted: new pivot or wick-probe retested active zone after gap
//alertcondition(aTouch, "Support touch", "ASZE: a valid touch/test was counted on an active support zone of {{ticker}}.")
// 5. Bounce: price rejected from support, closed back above mid/high after recent touch
//alertcondition(aBounce, "Support bounce", "ASZE: support bounce on {{ticker}} — price rejected from a support zone and closed back above it.")
// 6. Spring / False break: closed below zone then reclaimed above mid within 3 bars (Wyckoff trap)
//alertcondition(aSpring, "False break / spring", "ASZE: false break (spring) on {{ticker}} — support was briefly broken and reclaimed.")
// 7. Support breakout: was consolidating near zone then broke above consolidation high with ATR expansion
//alertcondition(aOut, "Support breakout", "ASZE: support breakout on {{ticker}} — bullish breakout from a support consolidation.")
// 8. Breakdown: zone invalidated - close below zone / ATR breach / consecutive closes below per invMode
//alertcondition(aBreak, "Support breakdown", "ASZE: support breakdown on {{ticker}} at {{close}} — a support zone was decisively broken.")
// 9. S->R reversal: broken support now acting as resistance (high retested zone, close below mid)
//alertcondition(aRev, "Support becomes resistance", "ASZE: role reversal on {{ticker}} — broken support is now acting as resistance (S to R).")
