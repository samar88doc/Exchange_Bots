// ═══════════════════════════════════════════════════════════════════════════
// KERNEL LABEL  (1 point)
// ═══════════════════════════════════════════════════════════════════════════
if kernelSignal
    label.new(x=bar_index, y=na, text="KERN", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// EMA 200 LABEL  (1 point)
// ═══════════════════════════════════════════════════════════════════════════
if ema200Signal
    label.new(x=bar_index, y=na, text="E200", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════
// EMAKER LABEL  (1 point)
// ═══════════════════════════════════════════════════════════════════════════
if emaMakerSignal
    label.new(x=bar_index, y=na, text="EMAKR", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.purple, 0), textcolor=color.white, size=size.small)

