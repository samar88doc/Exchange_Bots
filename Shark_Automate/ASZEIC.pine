// ============================================================================
// ================== NEW ALERT CONDITIONS (ACTIVE) ===========================
// Old alerts above are now COMMENTED as requested
// ============================================================================

// NEW 1 · (Strong OR Major support inside) + Score Threshold + (Kernel/Kmaker/Intmaker/Ktoucher/Slope)
// Logic: Strong/Major zone inside AND totalScore>=threshold AND any high-quality signal

bool priceInsideStrongMajor =  sActive > 0 and  not na(sLow) and  not na(sHigh) and  close >= sLow and  close <= sHigh and  sScore >= 60.0

bool newAlert1_core =  priceInsideStrongMajor and   threshold_idea and   (kernelSignal or kmakerSignal or intMakerSignal or ktoucherSignal or slopeSignal)

alertcondition( newAlert1_core,  title="NEW 1 · PRICE INSIDE STRONG/MAJOR + SCORE + SIGNAL",  message="NEW 1 on {{ticker}} at {{close}} — Price inside STRONG/MAJOR support + Score>=threshold + signal confluence!")
