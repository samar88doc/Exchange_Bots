plot(scoreSpring,     title="ASZE Spring Score",    display=display.data_window)
plot(scoreBreakout,   title="ASZE Breakout Score",  display=display.data_window)
plot(scoreConfluence, title="Confluence Bonus Score", display=display.data_window)
