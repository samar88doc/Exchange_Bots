# ============================================================================
# TV -> Shark Trading Platform — configuration template
# Copy to .env (or .env.paper / .env.live). NEVER commit real secrets.
# ============================================================================

# ---------------------------------------------------------------- core
APP_NAME=TV-Shark Trading Platform
ENVIRONMENT=development
TIMEZONE_DISPLAY=Asia/Kolkata
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- db
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ------------------------------------------------------------- risk core
# PAPER is the default. LIVE never activates automatically.
TRADING_MODE=PAPER
MARGIN_PER_TRADE=50
LEVERAGE=10
MAX_OPEN_POSITIONS=200
TARGET_ROI_PERCENT=8
STOP_LOSS_ENABLED=false
SHORT_ENABLED=true
ROI_INCLUDES_FEES=true
ORDER_TYPE=LIMIT
DAILY_TRADE_LIMIT=0
DAILY_LOSS_LIMIT=0
ACCOUNT_UNIT=USDT

# ------------------------------------------------------------- live gate
LIVE_TRADING_ENABLED=false
# Secret phrase required (in addition to the typed "ENABLE LIVE TRADING")
LIVE_TRADING_CONFIRMATION=

# -------------------------------------------------------------- webhooks
WEBHOOK_SECRET=change-me-to-a-long-random-value
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_REPLAY_WINDOW_SECONDS=900
TRADINGVIEW_PERPETUAL_SUFFIX=.P
SYMBOL_NORMALIZATION_ENABLED=true

# ---------------------------------------------------------- paper engine
PAPER_INITIAL_BALANCE=10000
PAPER_TAKER_FEE_BPS=5
PAPER_MAKER_FEE_BPS=2
PAPER_SLIPPAGE_BPS=2
PAPER_FUNDING_RATE_BPS_8H=0
PAPER_LATENCY_MS=0

# ------------------------------------------------------------- shark api
# Create API key + secret in the Shark UI (secret is shown only once).
SHARK_BASE_URL=https://api.sharkexchange.in
SHARK_API_KEY=
SHARK_API_SECRET=
SHARK_MARGIN_ASSET=INR
SHARK_DEVICE_TYPE=WEB
SHARK_USER_CATEGORY=EXTERNAL
SHARK_REQUEST_TIMEOUT_SECONDS=10
# DRY RUN=true builds + logs the exact order payload but NEVER transmits it.
SHARK_DRY_RUN=true

# ------------------------------------------------------------- workers
ROI_MONITOR_INTERVAL_SECONDS=1
RECONCILIATION_INTERVAL_SECONDS=60
MARKET_POLL_INTERVAL_SECONDS=2
STALE_RESERVATION_SECONDS=120

# -------------------------------------------------------- notifications
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
