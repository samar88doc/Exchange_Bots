# ==============================================================================
# Git Ignore - Exchange_Bots Monorepo
# ==============================================================================

# Environment files & Secrets
.env
.env.*
!.env.example
*.session
*.session-journal
*.pem
*.key
*.cert

# Databases & local state
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*
!data/.gitkeep
backups/
data/backups/
KILL_SWITCH
*.pid
*.log
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.sudo_as_admin_successful

# Git backups of previous sub-repos
.git_backup*
*_backup_*
nohup.out
*.out

# Host credentials & temp files
host.txt
.~lock.*

